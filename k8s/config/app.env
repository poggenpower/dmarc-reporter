DJANGO_ALLOWED_HOSTS=reports.example.com,dmarc-reporter-web,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://reports.example.com
DJANGO_DEBUG=false
DJANGO_TRUST_PROXY_SSL=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DATA_DIR=/data
GEOIP_CITY_DB=/geoip/dbip-city-lite.mmdb
GEOIP_ASN_DB=/geoip/dbip-asn-lite.mmdb
IMAP_HOST=imap.example.net
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL=300
IMAP_BATCH_SIZE=100
SMTP_HOST=mail.example.net
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=reports@example.com
REPORT_API_URL=https://reports.example.com/api/v1/reports/
